{
  "name": "@shapeshift-labs/frontier-event-log",
  "version": "0.1.2",
  "description": "Bounded in-memory event logs, replay cursors, compaction, and Frontier patch events.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/siliconjungle/-shapeshift-labs-frontier-event-log.git"
  },
  "homepage": "https://github.com/siliconjungle/-shapeshift-labs-frontier-event-log#readme",
  "bugs": {
    "url": "https://github.com/siliconjungle/-shapeshift-labs-frontier-event-log/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./event-log": {
      "types": "./dist/event-log.d.ts",
      "import": "./dist/event-log.js",
      "default": "./dist/event-log.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "event-log": [
        "./dist/event-log.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "benchmarks/package-bench.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@shapeshift-labs/frontier": "0.1.8"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && npm run typecheck && node test/smoke.mjs && node test/fuzz.mjs --cases 500",
    "prepack": "npm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "fuzz": "npm run build && node test/fuzz.mjs",
    "bench": "npm run build && node benchmarks/package-bench.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "frontier",
    "event-log",
    "replay",
    "cursor",
    "compaction",
    "state"
  ],
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
